# Copy to .env.local and fill in values for production.
# Leave unset (or keep placeholders) to run in demo mode.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Force demo mode even if Supabase vars are set: HELP_DESK_DEMO_MODE=true
# Force live mode: HELP_DESK_DEMO_MODE=false
# HELP_DESK_DEMO_MODE=true

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxx
# Public helpdesk mailbox (clients write here; agents reply as this address)
RESEND_FROM_EMAIL=SOPORTE IT <incidencias@grupoatvalor.com>
# Optional. If unset, clients Reply to the From address (incidencias@). Recommended.
# RESEND_REPLY_TO=incidencias@grupoatvalor.com
# Resend inbound address — only for the Outlook Redirect/BCC rule (not for clients)
RESEND_INBOUND_EMAIL=tickets@pelioluu.resend.app
# Svix signing secret from Resend (whsec_...) OR a shared secret you choose
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
