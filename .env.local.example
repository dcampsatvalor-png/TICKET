# Copy to .env.local and fill in values for production.
# Leave unset (or keep placeholders) to run in demo mode.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Force demo mode even if Supabase vars are set: HELP_DESK_DEMO_MODE=true
# Force live mode: HELP_DESK_DEMO_MODE=false
# HELP_DESK_DEMO_MODE=true

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=SOPORTE IT <soporte@grupoatvalor.com>
# Where client "Reply" should go (Resend inbound address)
RESEND_REPLY_TO=tickets@pelioluu.resend.app
# Required for replies to appear in the same Outlook conversation:
# use Redirect or BCC copy to Resend — not Forward (Forward invents a new Message-ID).
# Svix signing secret from Resend (whsec_...) OR a shared secret you choose
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
